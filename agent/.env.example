# Port the agent listens on
PORT=3001

# Shared secret — must match AGENT_TOKEN in the Next.js app
# Generate with: openssl rand -hex 32
# [MANDATORY]
AGENT_TOKEN=change_me

# Path to Docker socket
# Linux / Pi:       /var/run/docker.sock
# OrbStack (macOS): /Users/<you>/.orbstack/run/docker.sock
# Docker Desktop:   /Users/<you>/.docker/run/docker.sock
# Leave unset to auto-detect.
# [OPTIONAL]
#DOCKER_SOCKET=

# docker-compose project name filter (leave empty to show all containers)
# [OPTIONAL]
COMPOSE_PROJECT=
