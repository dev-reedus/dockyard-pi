# URL of the Node agent running on the Pi
AGENT_BASE_URL=http://raspberrypi.local:3001

# Shared secret between the Next.js app and the Pi agent
# Generate with: openssl rand -hex 32
AGENT_TOKEN=

# How often the client polls the agent for live data (milliseconds)
NEXT_PUBLIC_POLL_INTERVAL=10000

# Secret used to generate HMAC for HMAC-SHA256 cookie in format <token>.<hmac>
# Generate with: openssl rand -hex 32
AUTH_SECRET=
AUTH_PASSWORD=yourpassword

# Path to Docker socket — used by compose to mount the correct socket into the agent.
# Linux / Pi:       /var/run/docker.sock  (default, leave unset)
# OrbStack (macOS): /Users/<you>/.orbstack/run/docker.sock
# Docker Desktop:   /Users/<you>/.docker/run/docker.sock
DOCKER_SOCKET=
